# Server
PORT=4000
NODE_ENV=development

# Database (include the database name explicitly, e.g. /wellvision)
MONGODB_URI=mongodb://127.0.0.1:27017/wellvision

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Email (Brevo SMTP)
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# SMS (Twilio)
TWILIO_FROM_NUMBER=
